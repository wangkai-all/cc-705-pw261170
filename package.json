{
  "name": "snmp-table-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SNMP table collector demo with MIB-driven index decoding, a local demo agent and a Vue UI",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "asn1-ber": "^1.2.2",
    "better-sqlite3": "^13.2.0",
    "express": "^5.1.0",
    "net-snmp": "^3.29.3",
    "vue": "^3.5.46",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "vite": "^8.3.8"
  }
}
